{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      // mirrors the Vite alias → the committed copy at src/lib/underwriting.ts,
      // regenerated from agents/ by `npm run gen:abis`. Self-contained so the
      // build has no dependency on files outside web/.
      "@bonded/underwriting": ["./src/lib/underwriting.ts"]
    }
  },
  "include": ["src"]
}
